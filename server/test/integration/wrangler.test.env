# Test-only bindings for the real local Worker started by globalSetup.ts.
# Keeping these explicit makes the suite independent of ignored developer files.
DEV_AUTH=1
SESSION_SECRET=integration-test-only-session-secret
MIGRATION_CUTOFF_MS=4102444800000
RL_AUTH_MAX=100000
BLACK_MARKET_ENABLED=1
# Friend invasions are parked in deployed envs; the suite keeps guarding them.
PVP_ENABLED=1
# The suite covers BOTH defense modes: this sets the default the Worker runs under,
# and the mode-specific specs assert against it. Formation is the one under
# development, so it is the one a bare run exercises.
PVP_DEFENSE_MODE=formation

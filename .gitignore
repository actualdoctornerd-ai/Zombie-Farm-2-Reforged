node_modules/
dist/
*.local
.DS_Store
__pycache__/
*.pyc

# Scratch space: rig captures written by /zombie-review.html via the dev-only
# /__capture endpoint, console-setup dumps, working files. Ignored wholesale — put
# nothing here you mean to keep. (The QA renders already committed under tmp/pdfs/
# stay tracked; an ignore rule only ever applies to files git isn't following yet.)
tmp/

# Local output of launcher/build-package.ps1 (the ~90 MB Windows zip).
launcher/out/

# Rust build output for the desktop shell (desktop/README.md).
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Offline bundle built with `--outDir dist-offline` (see desktop/README.md).
dist-offline/

# The built Rig Studio (~11 MB: it inlines every rig, stage, Epic Boss strip and the
# tile lab as data URIs). Unlike tile_lab.html — which is small and gets handed to
# people who do not have the repo — this one is only ever used from a checkout, and
# committing it would add another 11 MB blob on every art change. Rebuild it with
#   python tools/build_rig_studio.py        (--no-epic for a ~6 MB one)
tools/rig_studio.html

# Local API credentials (never commit).
.secrets/

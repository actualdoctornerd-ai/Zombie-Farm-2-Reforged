{
  "name": "zombiefarm",
  "private": true,
  "version": "0.2.3",
  "license": "MIT",
  "type": "module",
  "description": "Zombie Farm Reforged - browser reimplementation with optional online mode",
  "scripts": {
    "dev": "vite",
    "review:zombies": "vite --open /zombie-review.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:replay-benchmark": "vitest run --config vitest.replay.config.ts",
    "test:watch": "vitest",
    "test:difficulty": "vitest run --config vitest.difficulty.config.ts && node tools/difficulty_table.mjs",
    "test:cohorts": "vitest run --config vitest.cohorts.config.ts && node tools/cohort_table.mjs",
    "test:strength": "vitest run --config vitest.strength.config.ts && node tools/strength_table.mjs && node tools/strength_page.mjs",
    "test:builds": "vitest run --config vitest.builds.config.ts && node tools/build_table.mjs",
    "test:mechanics": "vitest run --config vitest.mechanics.config.ts && node tools/mechanic_table.mjs",
    "test:search": "vitest run --config vitest.search.config.ts && node tools/search_table.mjs && node tools/army_structure.mjs",
    "test:effective": "vitest run --config vitest.effective.config.ts && vitest run --config vitest.effectiveFit.config.ts && node tools/effective_table.mjs",
    "test:monotonic": "vitest run --config vitest.monotonic.config.ts && node tools/monotonic_table.mjs",
    "test:lethality": "vitest run --config vitest.lethality.config.ts && node tools/lethality_table.mjs",
    "test:search-fast": "node tools/search_fast.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}